# Copie este arquivo para ".env" (mesma pasta) e preencha com os seus dados.
# O ".env" NÃO vai para o GitHub (está no .gitignore). Nunca coloque senhas neste .env.example.

# Conexão com o PostgreSQL usada pelo Rails (dotenv-rails carrega este arquivo sozinho).
# Formato: postgresql://USUARIO:SENHA@SERVIDOR:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/library_development

# Banco usado só pelos testes (bin/rails test). Pode deixar comentado se for o mesmo servidor local.
# TEST_DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/library_test

# Sites que podem chamar a API pelo navegador (separados por vírgula). O localhost já é liberado.
CORS_ORIGINS=https://livros-pra-vida.github.io

# Chaves da criptografia do banco (chat, CPF, telefone, endereço). Gere com: bin/rails db:encryption:init
# Copie os 3 valores que aparecerem. NÃO perca essas chaves: sem elas os dados criptografados não podem ser lidos.
ENCRYPTION_PRIMARY_KEY=
ENCRYPTION_DETERMINISTIC_KEY=
ENCRYPTION_KEY_DERIVATION_SALT=
